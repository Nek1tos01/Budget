{
  "name": "budget-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:receipt-media": "playwright test --config playwright.receipt-media.config.ts",
    "build:wasm": "node scripts/build-budget-wasm.mjs",
    "db:local": "wrangler d1 migrations apply budget --local",
    "dev:cloud": "wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "test:cloud": "node --test tests/integration/cloud.test.mjs",
    "test:e2e:cloud": "playwright test --config playwright.cloud.config.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/rus": "1.0.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "emoji-regex": "11.0.0",
    "lucide-react": "^1.76.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
